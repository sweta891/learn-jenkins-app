
pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }

            steps {
                sh '''
                    echo "Checking Node and npm"
                    node --version
                    npm --version

                    echo "Cleaning npm cache"
                    npm cache clean --force

                    echo "Installing dependencies"
                    npm ci --no-audit --no-fund

                    echo "Building React application"
                    npm run build
                '''
            }
        }
    }
}
